{
  "manifest_version": 3,
  "name": "🎯 Stake Dice Dynamic 19-Step Sniper",
  "version": "1.0.9",
  "description": "Stake Dice Bot • รองรับทนแพ้ 19 ไม้ • ระบบ Anti-Chop & Cluster Loss Shield • ทบต้น Dynamic • โหมด ECO พักสายตา",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://stake.com/*",
    "https://www.stake.com/*",
    "https://stake.bet/*",
    "https://stake.games/*",
    "https://stake.bz/*",
    "https://stake.ceo/*",
    "https://stake.mba/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "🎯 Stake Dice 19-Step Sniper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.stake.com/*",
        "*://*.stake.bet/*",
        "*://*.stake.games/*",
        "*://*.stake.bz/*",
        "*://*.stake.ceo/*",
        "*://*.stake.mba/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
