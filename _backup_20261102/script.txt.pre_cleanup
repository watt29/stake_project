
// ==UserScript==
// @name         Stake Dice Auto Bot - Advanced START STOP
// @namespace    http://tampermonkey.net/
// @version      2026.10.23.9
// @description  Advanced tab, auto start 5s, restart 3s, manual START/STOP
// @match        https://stake.com/*
// @match        https://www.stake.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // =============== CONFIG ===============
    const BET_AMOUNT = '0.005';
    const CHANCE = '60';
    const BET_COUNT = '1000';

    const START_DELAY = 5000;
    const RESTART_DELAY = 3000;
    const CHECK_INTERVAL = 500;

    const PANEL_ID = 'diceBotManualPanelFixed';

    // =============== STATE ================
    let enabled = false;
    let startedOnce = false;
    let starting = false;
    let restartTimer = null;
    let startTimer = null;
    let flowId = 0;
    let lastStatus = null;
    let ui = null;

    const log = (...args) => console.log('[Dice Bot]', ...args);

    const sleep = ms =>
        new Promise(resolve => setTimeout(resolve, ms));

    // =============== HELPERS ==============
    function visible(el) {
        if (!el) return false;
        const r = el.getBoundingClientRect();
        return r.width > 0 && r.height > 0;
    }

    function findVisible(selector) {
        return [...document.querySelectorAll(selector)].find(visible) || null;
    }

    function statusText(message) {
        if (ui) ui.status.textContent = message;
        log(message);
    }

    // =============== ADVANCED TAB =========
    // ใช้ selector ของปุ่ม Advanced จากโค้ดเดิม
    function getAdvancedButton() {
        return findVisible('button[data-testid="advanced-tab"]') ||
               findVisible('button[data-analytics="advanced-bet-button"]');
    }

    function openAdvanced() {
        const button = getAdvancedButton();

        if (!button) {
            statusText('ไม่พบปุ่ม Advanced');
            return false;
        }

        button.click();
        log('คลิก Advanced แล้ว');
        return true;
    }

    // =============== INPUTS ===============
    function getAmountInput() {
        return findVisible('input[data-testid="input-game-amount"]');
    }

    function getChanceInput() {
        return findVisible('input[data-testid="chance"]');
    }

    function getBetCountInput() {
        const selectors = [
            'input[data-testid="input-number-of-bets"]',
            'input[data-testid="number-of-bets"]',
            'input[data-testid="input-game-bet-count"]',
            'input[data-testid="bet-count"]',
            'input[data-testid="auto-bet-count"]'
        ];

        for (const selector of selectors) {
            const input = findVisible(selector);
            if (input) return input;
        }

        // สำรอง: ค้นหาช่องใกล้ข้อความ Number of bets
        const labels = [...document.querySelectorAll(
            'label, span, div, p'
        )];

        for (const label of labels) {
            const text = (label.textContent || '').trim();

            if (
                text !== 'จำนวนการเดิมพัน' &&
                !/^number of bets$/i.test(text)
            ) continue;

            let parent = label;

            for (let i = 0; i < 3 && parent; i++) {
                const input = parent.querySelector('input');

                if (
                    input &&
                    input !== getAmountInput() &&
                    input !== getChanceInput() &&
                    visible(input)
                ) {
                    return input;
                }

                parent = parent.parentElement;
            }
        }

        return null;
    }

    function setInput(input, value) {
        if (!input) return false;

        const descriptor = Object.getOwnPropertyDescriptor(
            HTMLInputElement.prototype,
            'value'
        );

        if (!descriptor || !descriptor.set) return false;

        descriptor.set.call(input, String(value));

        input.dispatchEvent(new Event('input', {
            bubbles: true
        }));

        input.dispatchEvent(new Event('change', {
            bubbles: true
        }));

        return Number(input.value) === Number(value);
    }

    function setValues() {
        const amount = getAmountInput();
        const chance = getChanceInput();
        const count = getBetCountInput();

        if (!amount || !chance) {
            log('ไม่พบช่องเดิมพันหรือโอกาสชนะ', {
                amount: !!amount,
                chance: !!chance
            });
            return false;
        }

        const amountOK = setInput(amount, BET_AMOUNT);
        const chanceOK = setInput(chance, CHANCE);

        // ถ้าหาช่องจำนวนตาเจอ ให้ตั้งจำนวนตาด้วย
        let countOK = true;

        if (count) {
            countOK = setInput(count, BET_COUNT);
        }

        log('ผลตั้งค่า:', {
            amount: amount.value,
            chance: chance.value,
            betCount: count ? count.value : 'ไม่พบช่องจำนวนตา'
        });

        return amountOK && chanceOK && countOK;
    }

    // =============== AUTOBET BUTTON =======
    function getAutoButton() {
        return findVisible(
            'button[data-testid="auto-bet-button"]'
        );
    }

    function getAutoStatus() {
        const button = getAutoButton();
        if (!button) return null;

        const value = button.getAttribute('data-autobet-status');

        if (value === 'start' || value === 'stop') {
            return value;
        }

        const text = (
            (button.textContent || '') + ' ' +
            (button.getAttribute('aria-label') || '')
        ).trim();

        if (/หยุด|stop|cancel/i.test(text)) return 'stop';
        if (/เริ่ม|start|begin/i.test(text)) return 'start';

        return null;
    }

    function clickStartButton() {
        const button = getAutoButton();
        const state = getAutoStatus();

        if (!button) {
            statusText('ไม่พบปุ่ม Auto Bet');
            return false;
        }

        // stop หมายถึงกำลังเดิมพันอยู่ ไม่คลิกซ้ำ
        if (state === 'stop') {
            startedOnce = true;
            lastStatus = 'stop';
            statusText('Auto Bet กำลังทำงานอยู่');
            return true;
        }

        if (state !== 'start') {
            statusText('อ่านสถานะปุ่ม Auto Bet ไม่ได้');
            return false;
        }

        button.click();

        statusText('ส่งคำสั่งเริ่ม Auto Bet แล้ว');
        log('คลิกปุ่ม Auto Bet');
        return true;
    }

    // =============== START SESSION ========
    async function startSession() {
        if (!enabled || starting) return;

        starting = true;
        const thisFlow = flowId;

        try {
            statusText('กำลังเปิด Advanced…');

            if (!openAdvanced()) return;

            // รอให้แท็บเปลี่ยนและช่องกรอกพร้อม
            let ready = false;

            for (let i = 0; i < 20; i++) {
                await sleep(300);

                if (!enabled || thisFlow !== flowId) return;

                if (getAutoButton() && getAmountInput() && getChanceInput()) {
                    ready = true;
                    break;
                }
            }

            if (!ready) {
                statusText('เปิด Advanced แล้ว แต่ไม่พบช่องหรือปุ่ม Auto Bet');
                return;
            }

            if (!setValues()) {
                statusText('ตั้งค่าไม่สำเร็จ — ยกเลิกการเริ่ม');
                return;
            }

            if (!enabled || thisFlow !== flowId) return;

            if (clickStartButton()) {
                lastStatus = getAutoStatus();
            }
        } finally {
            starting = false;
            refreshButtons();
        }
    }

    function startBot() {
        if (enabled) return;

        flowId++;
        enabled = true;
        startedOnce = false;
        lastStatus = null;

        clearTimers();

        statusText('เริ่ม Session ใหม่ — รอ 5 วินาที…');
        refreshButtons();

        const thisFlow = flowId;

        startTimer = setTimeout(() => {
            startTimer = null;

            if (!enabled || thisFlow !== flowId) return;

            startSession();
        }, START_DELAY);
    }

    // =============== STOP =================
    function stopBot() {
        enabled = false;
        flowId++;
        starting = false;

        clearTimers();

        const button = getAutoButton();

        if (button && getAutoStatus() === 'stop') {
            button.click();
            statusText('ส่งคำสั่งหยุดเดิมพันแล้ว');
        } else {
            statusText('หยุดระบบแล้ว');
        }

        startedOnce = false;
        lastStatus = null;
        refreshButtons();
    }

    function clearTimers() {
        if (startTimer !== null) clearTimeout(startTimer);
        if (restartTimer !== null) clearTimeout(restartTimer);

        startTimer = null;
        restartTimer = null;
    }

    // =============== RESTART MONITOR ======
    function monitor() {
        if (!enabled || starting || startTimer !== null) return;

        const state = getAutoStatus();

        if (state === 'stop') {
            // เว็บกำลังเดิมพัน
            startedOnce = true;
            lastStatus = 'stop';

            if (restartTimer !== null) {
                clearTimeout(restartTimer);
                restartTimer = null;
            }

            if (ui) ui.status.textContent = 'กำลังเดิมพัน…';
            return;
        }

        // เริ่มใหม่เฉพาะเมื่อเคยเห็นสถานะกำลังเดิมพันแล้ว
        // ป้องกันเริ่มซ้ำหากคำสั่งเริ่มครั้งแรกไม่สำเร็จ
        if (
            state === 'start' &&
            startedOnce &&
            lastStatus === 'stop' &&
            restartTimer === null
        ) {
            statusText('รอ 3 วินาทีก่อนเริ่มรอบใหม่…');

            restartTimer = setTimeout(async () => {
                restartTimer = null;

                if (!enabled) return;

                // ตรวจว่ารอบก่อนหยุดแล้วจริง
                if (getAutoStatus() !== 'start') return;

                await startSession();
            }, RESTART_DELAY);
        }

        lastStatus = state;
    }

    // =============== PANEL =================
    function refreshButtons() {
        if (!ui) return;

        ui.start.disabled = enabled;
        ui.start.style.opacity = enabled ? '0.5' : '1';
        ui.stop.disabled = false;
        ui.stop.style.opacity = '1';
    }

    function createPanel() {
        if (!document.body || document.getElementById(PANEL_ID)) return;

        const panel = document.createElement('div');
        panel.id = PANEL_ID;

        panel.style.cssText = [
            'position:fixed',
            'top:150px',
            'left:20px',
            'z-index:2147483647',
            'width:230px',
            'padding:12px',
            'background:#222',
            'color:#fff',
            'border:1px solid #555',
            'border-radius:10px',
            'font:13px Arial,sans-serif',
            'box-shadow:0 4px 15px #0007',
            'user-select:none'
        ].join(';');

        panel.innerHTML = `
            <div id="diceBotHeader"
                 style="font-weight:bold;font-size:15px;margin-bottom:8px;cursor:move">
                DICE BOT • ADVANCED
            </div>

            <div style="margin-bottom:8px">
                Bet: ${BET_AMOUNT}<br>
                Chance: ${CHANCE}%<br>
                จำนวนตา: ${BET_COUNT}<br>
                เริ่ม: 5 วินาที | รอบใหม่: 3 วินาที
            </div>

            <div id="diceBotFixedStatus"
                 style="min-height:18px;margin-bottom:10px;color:#b1bad3">
                กำลังเตรียมระบบ…
            </div>

            <div style="display:flex;gap:7px">
                <button id="diceBotFixedStart"
                    style="flex:1;background:#168a2f;color:white;border:0;padding:9px;border-radius:6px;cursor:pointer;font-weight:bold">
                    START
                </button>

                <button id="diceBotFixedStop"
                    style="flex:1;background:#c62828;color:white;border:0;padding:9px;border-radius:6px;cursor:pointer;font-weight:bold">
                    STOP
                </button>
            </div>
        `;

        document.body.appendChild(panel);

        ui = {
            panel,
            status: panel.querySelector('#diceBotFixedStatus'),
            start: panel.querySelector('#diceBotFixedStart'),
            stop: panel.querySelector('#diceBotFixedStop')
        };

        ui.start.addEventListener('click', startBot);
        ui.stop.addEventListener('click', stopBot);

        // ลากแผงควบคุม
        const header = panel.querySelector('#diceBotHeader');
        let dragging = false;
        let dx = 0;
        let dy = 0;

        header.addEventListener('mousedown', event => {
            dragging = true;
            dx = event.clientX - panel.offsetLeft;
            dy = event.clientY - panel.offsetTop;
        });

        document.addEventListener('mousemove', event => {
            if (!dragging) return;
            panel.style.left = Math.max(0, event.clientX - dx) + 'px';
            panel.style.top = Math.max(0, event.clientY - dy) + 'px';
        });

        document.addEventListener('mouseup', () => {
            dragging = false;
        });

        refreshButtons();
    }

    // ESC หยุดระบบ
    window.addEventListener('keydown', event => {
        if (event.key === 'Escape') stopBot();
    }, true);

    // ตรวจสถานะ Auto Bet
    setInterval(monitor, CHECK_INTERVAL);

    // =============== INITIALIZE ============
    const boot = setInterval(() => {
        if (!document.body) return;

        createPanel();

        if (ui) {
            clearInterval(boot);

            // เริ่มอัตโนมัติหลังเปิดหน้าเว็บ 5 วินาที
            startBot();
        }
    }, 300);

})();
